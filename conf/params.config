/*
 * Every parameter of the pipeline, and nothing else.
 *
 * This file is split out of nextflow.config so another pipeline can include the
 * PPI_SPLITTING workflow (main.nf) as a subworkflow and still get its defaults:
 * Nextflow reads only the *root* project's nextflow.config, so an embedded
 * pipeline's own params block is never seen. The embedding project therefore does
 *
 *     includeConfig 'subworkflows/external/ppi-splitting/conf/params.config'
 *
 * before its own `params { }` block -- before, because a later assignment wins,
 * and `outdir` is defined on both sides. Profiles, process resources, the manifest
 * and the plugins block stay in nextflow.config: the embedding project supplies
 * its own.
 *
 * Nothing here may reference `projectDir`. When included, that resolves to the
 * root project's directory, which is not this repo (use `moduleDir`, or keep the
 * path in nextflow.config -- the test profiles do the latter).
 */

params {
    samplesheet            = "samplesheet.csv"
    outdir                 = "results"
    // Best-practice short run: skip FETCH_DATA/CLUSTERING/TRAIN_BASELINE/QC
    // entirely -- every dataset must supply sequences/go_annotations/species
    // and a precomputed partition/node_mapping, and split_method/
    // negative_sampling_method are forced to "ilp" regardless of the
    // samplesheet -- so the run only executes SOLVE_ILP, CDHIT2D,
    // REMOVE_REDUNDANT, and SAMPLE_NEGATIVES_ILP before emitting the splits.
    split_only             = false
    embedding_model        = "esm2"  // "none" (one-hot), "esm2", "prot_t5", or path to pre-computed .npz
    cdhit_identity         = 0.4
    cdhit_wordsize         = 2
    seed                   = 42
    heatmap_max_per_split  = 500
    // Splitting method: "kahip" (default), "ilp", or "random" (naive baseline, see README)
    split_method           = "kahip"
    // Kahip parameters
    edge_weight            = "normalized_bitscore"  // "bitscore" or "normalized_bitscore"
    kahip_seed             = 1234
    kahip_k                = 3
    kahip_preconfiguration = "strong"
    // ILP parameters
    ilp_kahip_k            = 100  // number of KaHIP partitions ("clusters") fed into the ILP
    train_split            = 0.8
    val_split              = 0.1
    test_split             = 0.1
    ilp_epsilon            = 0.05
    ilp_max_sec            = 7200
    ilp_solver             = "GUROBI"
    gurobi_license         = "gurobi.lic"  // path to a gurobi.lic (e.g. WLS) file, only needed if --ilp_solver GUROBI
    // Negative sampling method: "default" (SAMPLE_NEGATIVES_DEGREE), "ilp" (SAMPLE_NEGATIVES_ILP),
    // "ilp_candidates" (SAMPLE_NEGATIVES_ILP restricted to the row's candidate_network pool),
    // or "uniform" (SAMPLE_NEGATIVES_DEGREE, uniform negatives for every split -- naive baseline, see README).
    //
    // A comma-separated list names several negative sets to draw from one shared
    // positive split, e.g. "ilp,ilp_candidates": the positive halves of the
    // resulting datasets are then byte-identical and the split files gain a
    // "_<method>" suffix. A single entry leaves every filename as it was.
    negative_sampling_method = "default"
    neg_ilp_lambda_degree    = 1.0
    neg_ilp_lambda_taxon_pair = 1.0
    neg_ilp_lambda_self_loop = 1.0
    neg_ilp_lambda_jaccard   = 1.0
    neg_ilp_solver           = "auto"     // "auto", "gurobi", "scip", or "highs"
    neg_ilp_time_limit       = 7200
    neg_ilp_mip_gap          = 0.01
    // Display order of the datasets in the MultiQC report. Names are the display
    // labels -- meta.mqc_labels where a caller supplied one, otherwise
    // "<id><negative-set suffix>". Empty (the default) orders them
    // alphabetically. A name matching no dataset is warned about and ignored; a
    // dataset the list does not mention is appended after the listed ones,
    // alphabetically. A Groovy list here, or a comma-separated string on the
    // command line (--mqc_order 'a,b'). Report only: no published filename,
    // directory or --split-name value depends on it.
    mqc_order                = []
    // DDI mode: split domain-domain interactions (Pfam family pairs) instead of PPIs.
    // In this mode the interaction file's protein1/protein2 columns hold Pfam accessions.
    ddi_mode                 = false // route DATA_PREP through DATA_PREP_DDI
    ddi_examples_target      = 5     // N: instance-pair examples per DDI
    ddi_examples_pool_factor = 5     // M = N * this: instances sampled per family
    // SELECT_EXAMPLES. It reuses ilp_solver/gurobi_license rather than adding its
    // own knobs -- same CVXPY solver names, same license file as SOLVE_ILP.
    ddi_select_max_sec       = 300   // total budget across every component's lexicographic stages
    ddi_max_ilp_candidates   = 200000 // a component larger than this skips the ILP for the greedy fallback
    ddi_lambda_diversity     = 0.1   // parent-reuse penalty; must stay < 0.5 (see select_examples.py)
    ddi_shortlist_factor     = 4     // cap a DDI's candidate pool at this * N before the ILP
    ddi_select_verbose       = false // let the SELECT_EXAMPLES solver print its own log to .command.err
    ddi_candidate_factor     = 4     // cap candidate_network pairs per split at this * the split's DDI count
    // Which Pfam strata FETCH_DOMAIN_META may sample, as a comma-separated list
    // (or a List) of names out of human_reviewed, other_reviewed, human_unreviewed,
    // other_unreviewed. They fill in that order -- reviewed outranks human, so a
    // family with no human Swiss-Prot member takes a curated non-human sequence
    // before an auto-annotated human one -- and a stratum left out is never offered
    // a record, so a family with nothing in a named one ends with zero instances and
    // every DDI touching it drops out of the run. The unreviewed strata need a
    // TrEMBL file in uniprot_dat; Swiss-Prot alone can fill only the reviewed two,
    // and fetch_domains.py errors rather than quietly under-filling.
    instance_tiers           = "human_reviewed"
    interpro_cache           = null  // directory for cached Pfam/UniProt downloads; resolved to an absolute path, and must be shared across compute nodes
    pfam_regions             = null  // local Pfam-A.regions.tsv.gz, skipping the ~4.7 GB download
    uniprot_dat              = null  // UniProt flat file(s): the protein universe (sequence + taxon + review flag). A List or a comma-separated string, Swiss-Prot first (first file carrying an accession wins). Swiss-Prot alone is downloaded (~600 MB) when unset
    pfam_clans               = null  // local Pfam-A.clans.tsv(.gz), skipping that download
    pfam_release             = null  // pin the release string instead of downloading Pfam.version (the one fetch a warm cache cannot skip)
}
