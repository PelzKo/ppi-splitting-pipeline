# Minimal image for `--split_only` runs: the ILP splitting core only.
# Published with the main image on every GitHub release as
# ghcr.io/bionetslab/ppi-splitting-pipeline-split-only (<release tag> and latest):
#   nextflow run main.nf --samplesheet s.csv --split_only \
#       -with-docker ghcr.io/bionetslab/ppi-splitting-pipeline-split-only:latest
#
# Does not carry bin/ (standalone runs only) and does not read environment.yml.
# Covers GET_LENGTHS, SORT_PPIS, SOLVE_ILP, CDHIT2D, REMOVE_REDUNDANT,
# SAMPLE_NEGATIVES_ILP and SAMPLE_NEGATIVES_DEGREE.
FROM mambaorg/micromamba:2.0.5

USER root

# procps: Nextflow's trace polling. ca-certificates: Gurobi WLS license check-out.
RUN apt-get update \
 && apt-get install -y --no-install-recommends procps ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# environment_split_only.yml is the only package source; do not add packages here.
ENV PIP_NO_CACHE_DIR=1
COPY environment_split_only.yml /tmp/environment.yml
RUN micromamba install -y -n base -f /tmp/environment.yml \
 && micromamba clean --all --yes
ENV PATH=/opt/conda/bin:$PATH

USER $MAMBA_USER
