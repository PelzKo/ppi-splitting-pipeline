plugins {
    id 'nf-schema@2.7.2'
}

// Every param lives in conf/params.config so a pipeline embedding PPI_SPLITTING
// can include that file on its own -- Nextflow reads only the root project's
// nextflow.config. See the header of that file.
includeConfig 'conf/params.config'

process {
    cpus   = 1
    memory = '4 GB'
    time   = '2 h'
    maxRetries = 1

    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 3
    }

    // Gurobi (WLS/floating) licenses cap concurrent sessions -- cap our own
    // concurrency to that limit and back off before retrying so a transient
    // "too many sessions" failure doesn't abort the whole run.
    withLabel:gurobi {
        maxForks     = 2
        beforeScript = { task.attempt > 1 ? "sleep ${task.attempt * 30}" : '' }
    }

    withName: 'FETCH_DATA' {
        cpus   = 1
        memory = '4 GB'
        time   = '6 h'
    }

    // One sequential pass over Pfam-A.regions.tsv.gz (~4.7 GB compressed), joined
    // against the protein universe held in RAM. Bounded by transfer in time and by
    // that universe in memory.
    withName: 'FETCH_DOMAIN_META' {
        cpus   = 1
        // The whole protein universe is held in RAM for the streaming pass, and it
        // is the tier set that sizes it: ~20k entries for human_reviewed alone,
        // ~573k (~3-4 GB, sequences dominating) once other_reviewed brings in the
        // rest of Swiss-Prot, more again with a TrEMBL file. The retry ladder would
        // reach it, but a 4.7 GB re-stream is an expensive way to discover a memory
        // setting. Reservoirs add pool_size x families on top.
        memory = '12 GB'
        time   = '6 h'
    }

    withName: 'RUN_BLAST' {
        cpus   = 64
        memory = '32 GB'
        time   = '12 h'
    }
    withName: 'RUN_KAHIP' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }
    withName: 'CDHIT2D' {
        cpus   = 4
        memory = '8 GB'
        time   = '8 h'
    }
    withName: 'EMBED_SEQUENCES' {
        cpus   = 4
        memory = '32 GB'
        time   = '12 h'
    }

    withName: 'TRAIN_CLASSIFIER' {
        memory = { 60.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: 'BIAS_ANALYSIS' {
        memory = { 60.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withName: 'SOLVE_ILP' {
        cpus   = 10
        memory = '32 GB'
        time   = '4 h'
    }

    withName: 'SELECT_EXAMPLES' {
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: 'SAMPLE_NEGATIVES_ILP' {
        cpus   = 8
        memory = '16 GB'
        time   = { 6.h * task.attempt }
    }

    withName: 'SAMPLE_NEGATIVES_DEGREE' {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: 'EXPAND_NEGATIVES' {
        cpus   = 1
        memory = { 16.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withName: 'MULTIQC' {
        memory = '16 GB'
    }
}

profiles {
    // Standalone runs only: it relies on $projectDir/bin being on PATH, which
    // Nextflow only does for the root project. Use the docker profile when this
    // pipeline is included as a subworkflow -- that image carries bin/ itself.
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }

    // One image for every process, like the conda profile's one environment. The
    // tag must match the git tag this checkout is at, because the image contains
    // bin/ (see docker/Dockerfile).
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.container = 'docker.io/konstantinpelz/ppi-splitting:1.0.0'
    }

    singularity {
        singularity.enabled     = true
        singularity.pullTimeout = '2 h'
        process.container       = 'docker.io/konstantinpelz/ppi-splitting:1.0.0'
    }

    apptainer {
        apptainer.enabled     = true
        apptainer.pullTimeout = '2 h'
        process.container     = 'docker.io/konstantinpelz/ppi-splitting:1.0.0'
    }

    slurm {
        process.executor = 'slurm'
    }

    test {
        params.samplesheet = "${projectDir}/assets/samplesheet_test.csv"
        params.outdir       = "${projectDir}/results/results_test"
        process {
            resourceLimits = [
                cpus: 4,
                memory: '3.GB',
                time: '1.h'
            ]
        }
    }

    // The DDI-mode counterpart, running the same method matrix on the committed
    // list of real Pfam family pairs (bin/other/make_ddi_fixture.py). Nothing is
    // precomputed -- no sequences, no species table, no instances.tsv -- so
    // FETCH_DOMAIN_META runs for real and the whole Pfam path is under test:
    // the ~6.3 GB Pfam-A.fasta.gz stream, the clan table, the tier cascade and
    // the reservoir sampling. That needs network access, which makes the first
    // run a minutes-not-seconds smoke test -- so the cache is on by default here
    // and every later run is a stat and a read. --pfam_regions / --pfam_clans /
    // --uniprot_dat point at local copies if they exist, and --pfam_release drops
    // the one download a warm cache still makes (Pfam.version, needed before the
    // cache dir is known).
    // ddi_mode is set here, so `-profile test_ddi` needs no --ddi_mode.
    test_ddi {
        params.samplesheet        = "${projectDir}/assets/samplesheet_test_ddi.csv"
        params.outdir             = "${projectDir}/results/results_test_ddi"
        params.ddi_mode           = true
        params.ddi_select_max_sec = 60
        // Both reviewed strata, which is what the pre-FORMAT_VERSION-3 default
        // ("any" over a Swiss-Prot universe) actually filled. The pipeline default
        // is human_reviewed alone, and most of data/test_ddis.csv's families have
        // no human region -- at the default the fixture would shrink to a handful
        // of DDIs and stop exercising the ILP paths.
        params.instance_tiers     = 'human_reviewed,other_reviewed'
        params.interpro_cache     = "${projectDir}/.pfam_cache"
        process {
            resourceLimits = [
                cpus: 4,
                memory: '4.GB',
                time: '6.h'
            ]
        }
    }
}
