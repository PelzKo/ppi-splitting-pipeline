plugins {
    id 'nf-schema@2.7.2'
}

params {
    samplesheet            = "samplesheet.csv"
    outdir                 = "results"
    // Best-practice short run: skip FETCH_DATA/CLUSTERING/TRAIN_BASELINE/QC
    // entirely -- every dataset must supply sequences/go_annotations/species
    // and a precomputed partition/node_mapping, and split_method/
    // negative_sampling_method are forced to "ilp" regardless of the
    // samplesheet -- so the run only executes SOLVE_ILP, CDHIT2D,
    // REMOVE_REDUNDANT, and SAMPLE_NEGATIVES_ILP before emitting the splits.
    split_only             = false
    embedding_model        = "esm2"  // "none" (one-hot), "esm2", "prot_t5", or path to pre-computed .npz
    cdhit_identity         = 0.4
    cdhit_wordsize         = 2
    seed                   = 42
    heatmap_max_per_split  = 500
    // Splitting method: "kahip" (default), "ilp", or "random" (naive baseline, see README)
    split_method           = "kahip"
    // Kahip parameters
    edge_weight            = "normalized_bitscore"  // "bitscore" or "normalized_bitscore"
    kahip_seed             = 1234
    kahip_k                = 3
    kahip_preconfiguration = "strong"
    // ILP parameters
    ilp_kahip_k            = 100  // number of KaHIP partitions ("clusters") fed into the ILP
    train_split            = 0.8
    val_split              = 0.1
    test_split             = 0.1
    ilp_epsilon            = 0.05
    ilp_max_sec            = 7200
    ilp_solver             = "GUROBI"
    gurobi_license         = "gurobi.lic"  // path to a gurobi.lic (e.g. WLS) file, only needed if --ilp_solver GUROBI
    // Negative sampling method: "default" (SAMPLE_NEGATIVES_DEGREE), "ilp" (SAMPLE_NEGATIVES_ILP),
    // or "uniform" (SAMPLE_NEGATIVES_DEGREE, uniform negatives for every split -- naive baseline, see README)
    negative_sampling_method = "default"
    neg_ilp_lambda_degree    = 1.0
    neg_ilp_lambda_taxon_pair = 1.0
    neg_ilp_lambda_self_loop = 1.0
    neg_ilp_lambda_jaccard   = 1.0
    neg_ilp_solver           = "auto"     // "auto", "gurobi", "scip", or "highs"
    neg_ilp_time_limit       = 7200
    neg_ilp_mip_gap          = 0.01
    // DDI mode: split domain-domain interactions (Pfam family pairs) instead of PPIs.
    // In this mode the interaction file's protein1/protein2 columns hold Pfam accessions.
    ddi_mode                 = false // route DATA_PREP through DATA_PREP_DDI
    ddi_examples_target      = 5     // N: instance-pair examples per DDI
    ddi_examples_pool_factor = 1     // M = N * this: instances sampled per family
    // SELECT_EXAMPLES. It reuses ilp_solver/gurobi_license rather than adding its
    // own knobs -- same CVXPY solver names, same license file as SOLVE_ILP.
    ddi_select_max_sec       = 300   // total budget across the three lexicographic stages
    ddi_lambda_diversity     = 0.1   // parent-reuse penalty; must stay < 0.5 (see select_examples.py)
    ddi_shortlist_factor     = 4     // cap a DDI's candidate pool at this * N before the ILP
    ddi_candidate_factor     = 4     // cap candidate_network pairs per split at this * the split's DDI count
    interpro_cache           = null  // directory for cached Pfam/UniProt downloads
    pfam_fasta               = null  // local Pfam-A.fasta.gz, skipping the ~6.3 GB download
    pfam_clans               = null  // local Pfam-A.clans.tsv(.gz), skipping that download
}

process {
    cpus   = 1
    memory = '4 GB'
    time   = '2 h'
    maxRetries = 1

    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 3
    }

    // Gurobi (WLS/floating) licenses cap concurrent sessions -- cap our own
    // concurrency to that limit and back off before retrying so a transient
    // "too many sessions" failure doesn't abort the whole run.
    withLabel:gurobi {
        maxForks     = 2
        beforeScript = { task.attempt > 1 ? "sleep ${task.attempt * 30}" : '' }
    }

    withName: 'FETCH_DATA' {
        cpus   = 1
        memory = '4 GB'
        time   = '6 h'
    }

    withName: 'RUN_BLAST' {
        cpus   = 64
        memory = '32 GB'
        time   = '12 h'
    }
    withName: 'RUN_KAHIP' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }
    withName: 'CDHIT2D' {
        cpus   = 4
        memory = '8 GB'
        time   = '4 h'
    }
    withName: 'EMBED_SEQUENCES' {
        memory = '32 GB'
        time   = '12 h'
    }

    withName: 'TRAIN_CLASSIFIER' {
        memory = { 60.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: 'BIAS_ANALYSIS' {
        memory = { 60.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: 'SOLVE_ILP' {
        cpus   = 10
        memory = '32 GB'
        time   = '4 h'
    }

    withName: 'SELECT_EXAMPLES' {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: 'SAMPLE_NEGATIVES_ILP' {
        cpus   = 8
        memory = '16 GB'
        time   = { 6.h * task.attempt }
    }

    withName: 'SAMPLE_NEGATIVES_DEGREE' {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: 'EXPAND_NEGATIVES' {
        cpus   = 1
        memory = { 16.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withName: 'MULTIQC' {
        memory = '16 GB'
    }
}

profiles {
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }

    docker {
        docker.enabled = true
    }

    slurm {
        process.executor = 'slurm'
    }

    test {
        params.samplesheet = "${projectDir}/assets/samplesheet_test.csv"
        params.outdir       = "${projectDir}/results/results_test"
        process {
            resourceLimits = [
                cpus: 4,
                memory: '3.GB',
                time: '1.h'
            ]
        }
    }
}
