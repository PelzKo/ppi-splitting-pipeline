plugins {
    id 'nf-schema@2.7.2'
}

// Every param lives in conf/params.config so a pipeline embedding PPI_SPLITTING
// can include that file on its own -- Nextflow reads only the root project's
// nextflow.config. See the header of that file.
includeConfig 'conf/params.config'

process {
    cpus   = 1
    memory = '4 GB'
    time   = '2 h'
    maxRetries = 1

    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 3
    }

    // Gurobi (WLS/floating) licenses cap concurrent sessions -- cap our own
    // concurrency to that limit and back off before retrying so a transient
    // "too many sessions" failure doesn't abort the whole run.
    withLabel:gurobi {
        maxForks     = 2
        beforeScript = { task.attempt > 1 ? "sleep ${task.attempt * 30}" : '' }
    }

    withName: 'FETCH_DATA' {
        cpus   = 1
        memory = '4 GB'
        time   = '6 h'
    }

    // One sequential pass over Pfam-A.fasta.gz (~6.3 GB compressed, ~13 GB of
    // text). Nothing is buffered beyond four reservoirs per family plus the
    // reviewed-accession set, so this is bounded by transfer, not by memory.
    withName: 'FETCH_DOMAIN_META' {
        cpus   = 1
        memory = '4 GB'
        time   = '6 h'
    }

    withName: 'RUN_BLAST' {
        cpus   = 64
        memory = '32 GB'
        time   = '12 h'
    }
    withName: 'RUN_KAHIP' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }
    withName: 'CDHIT2D' {
        cpus   = 4
        memory = '8 GB'
        time   = '8 h'
    }
    withName: 'EMBED_SEQUENCES' {
        cpus   = 4
        memory = '32 GB'
        time   = '12 h'
    }

    withName: 'TRAIN_CLASSIFIER' {
        memory = { 60.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: 'BIAS_ANALYSIS' {
        memory = { 60.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withName: 'SOLVE_ILP' {
        cpus   = 10
        memory = '32 GB'
        time   = '4 h'
    }

    withName: 'SELECT_EXAMPLES' {
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: 'SAMPLE_NEGATIVES_ILP' {
        cpus   = 8
        memory = '16 GB'
        time   = { 6.h * task.attempt }
    }

    withName: 'SAMPLE_NEGATIVES_DEGREE' {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: 'EXPAND_NEGATIVES' {
        cpus   = 1
        memory = { 16.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withName: 'MULTIQC' {
        memory = '16 GB'
    }
}

profiles {
    // Standalone runs only: it relies on $projectDir/bin being on PATH, which
    // Nextflow only does for the root project. Use the docker profile when this
    // pipeline is included as a subworkflow -- that image carries bin/ itself.
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }

    // One image for every process, like the conda profile's one environment. The
    // tag must match the git tag this checkout is at, because the image contains
    // bin/ (see Dockerfile).
    docker {
        docker.enabled   = true
        process.container = 'docker.io/konstantinpelz/ppi-splitting:0.1.0'
    }

    slurm {
        process.executor = 'slurm'
    }

    test {
        params.samplesheet = "${projectDir}/assets/samplesheet_test.csv"
        params.outdir       = "${projectDir}/results/results_test"
        process {
            resourceLimits = [
                cpus: 4,
                memory: '3.GB',
                time: '1.h'
            ]
        }
    }

    // The DDI-mode counterpart, running the same method matrix on the committed
    // list of real Pfam family pairs (bin/other/make_ddi_fixture.py). Nothing is
    // precomputed -- no sequences, no species table, no instances.tsv -- so
    // FETCH_DOMAIN_META runs for real and the whole Pfam path is under test:
    // the ~6.3 GB Pfam-A.fasta.gz stream, the clan table, the tier cascade and
    // the reservoir sampling. That needs network access, which makes the first
    // run a minutes-not-seconds smoke test -- so the cache is on by default here
    // and every later run is a stat and a read. --pfam_fasta / --pfam_clans point
    // at local copies if they exist, and --pfam_release drops the one download a
    // warm cache still makes (Pfam.version, needed before the cache dir is known).
    // ddi_mode is set here, so `-profile test_ddi` needs no --ddi_mode.
    test_ddi {
        params.samplesheet        = "${projectDir}/assets/samplesheet_test_ddi.csv"
        params.outdir             = "${projectDir}/results/results_test_ddi"
        params.ddi_mode           = true
        params.ddi_select_max_sec = 60
        params.interpro_cache     = "${projectDir}/.pfam_cache"
        process {
            resourceLimits = [
                cpus: 4,
                memory: '4.GB',
                time: '6.h'
            ]
        }
    }
}
